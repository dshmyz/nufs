{
  "annotations": {
    "list": []
  },
  "description": "NUFS 分布式文件系统生产监控面板",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Cluster Overview",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "title": "Online Nodes",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [{ "expr": "nufs_nodes_online", "legendFormat": "Online" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "mappings": []
        }
      }
    },
    {
      "title": "Total Nodes",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [{ "expr": "nufs_nodes_total", "legendFormat": "Total" }]
    },
    {
      "title": "Buckets",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "targets": [{ "expr": "nufs_buckets_total", "legendFormat": "Buckets" }]
    },
    {
      "title": "Total Chunks",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "targets": [{ "expr": "nufs_chunks_total", "legendFormat": "Chunks" }]
    },
    {
      "title": "Metadata Keys",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "targets": [{ "expr": "nufs_keys_total", "legendFormat": "Keys" }]
    },
    {
      "title": "Cache Hit Rate",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "targets": [{
        "expr": "rate(nufs_cache_hits_total[5m]) / (rate(nufs_cache_hits_total[5m]) + rate(nufs_cache_misses_total[5m])) * 100",
        "legendFormat": "Hit Rate %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 80 }] },
          "min": 0, "max": 100
        }
      }
    },
    {
      "title": "Operations",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "title": "Operations Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "rate(nufs_ops_total[5m])", "legendFormat": "Total ops/s" },
        { "expr": "rate(nufs_read_ops_total[5m])", "legendFormat": "Read ops/s" },
        { "expr": "rate(nufs_write_ops_total[5m])", "legendFormat": "Write ops/s" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "rate(nufs_errors_total[5m])", "legendFormat": "Errors/s" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "color": { "mode": "fixed", "fixedColor": "red" } }
      }
    },
    {
      "title": "Latency",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "title": "Read Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "targets": [
        { "expr": "nufs_read_latency_us{quantile=\"0.5\"}", "legendFormat": "p50" },
        { "expr": "nufs_read_latency_us{quantile=\"0.99\"}", "legendFormat": "p99" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "\u00b5s" }
      }
    },
    {
      "title": "Write Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "targets": [
        { "expr": "nufs_write_latency_us{quantile=\"0.5\"}", "legendFormat": "p50" },
        { "expr": "nufs_write_latency_us{quantile=\"0.99\"}", "legendFormat": "p99" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "\u00b5s" }
      }
    },
    {
      "title": "Disk I/O",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }
    },
    {
      "title": "Disk Throughput",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "expr": "rate(nufs_disk_read_bytes_total[5m])", "legendFormat": "Read B/s" },
        { "expr": "rate(nufs_disk_write_bytes_total[5m])", "legendFormat": "Write B/s" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps" }
      }
    },
    {
      "title": "Disk Usage",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 24 },
      "targets": [{
        "expr": "nufs_disk_used_bytes / nufs_disk_capacity_bytes * 100",
        "legendFormat": "Usage %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] },
          "min": 0, "max": 100
        }
      }
    },
    {
      "title": "Disk State",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 24 },
      "targets": [
        { "expr": "nufs_disk_state{state=\"healthy\"}", "legendFormat": "Healthy" },
        { "expr": "nufs_disk_state{state=\"degraded\"}", "legendFormat": "Degraded" },
        { "expr": "nufs_disk_state{state=\"failed\"}", "legendFormat": "Failed" }
      ]
    },
    {
      "title": "Raft Consensus",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }
    },
    {
      "title": "Raft State",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 33 },
      "targets": [{ "expr": "nufs_raft_state", "legendFormat": "State" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Follower", "color": "blue" }, "1": { "text": "Candidate", "color": "yellow" }, "2": { "text": "Leader", "color": "green" } } }
          ]
        }
      }
    },
    {
      "title": "Raft Term",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 33 },
      "targets": [{ "expr": "nufs_raft_term", "legendFormat": "Term" }]
    },
    {
      "title": "Raft Log Index",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 33 },
      "targets": [{ "expr": "nufs_raft_log_index", "legendFormat": "Log Index" }]
    },
    {
      "title": "WAL & GC",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 }
    },
    {
      "title": "WAL Fsync Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 38 },
      "targets": [
        { "expr": "rate(nufs_wal_fsync_total[5m])", "legendFormat": "Fsync/s" },
        { "expr": "rate(nufs_wal_bytes_written_total[5m])", "legendFormat": "Bytes/s" }
      ]
    },
    {
      "title": "GC Activity",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 38 },
      "targets": [
        { "expr": "rate(nufs_gc_scanned_chunks[5m])", "legendFormat": "Scanned/s" },
        { "expr": "rate(nufs_gc_deleted_chunks[5m])", "legendFormat": "Deleted/s" }
      ]
    },
    {
      "title": "生产就绪状态",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 46 }
    },
    {
      "title": "集群就绪状态",
      "description": "0=未就绪 1=降级 2=就绪",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 47 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        { "expr": "nufs_cluster_readiness", "legendFormat": "readiness", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "❌ 未就绪", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "⚠️ 降级", "color": "yellow" } } },
            { "type": "value", "options": { "2": { "text": "✅ 就绪", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 2 }
            ]
          }
        }
      }
    },
    {
      "title": "Leader 状态",
      "description": "1=稳定 0=不稳定",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 47 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        { "expr": "nufs_cluster_leader_stable", "legendFormat": "leader", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "❌ 不稳定", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "✅ 稳定", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "title": "最大可支撑 RF",
      "description": "当前集群可满足的最大副本因子",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 47 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        { "expr": "nufs_cluster_can_write_rf", "legendFormat": "can_write_rf", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 2 }, { "color": "green", "value": 3 }] }
        }
      }
    },
    {
      "title": "副本不足 Chunk 数",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 47 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        { "expr": "nufs_cluster_chunks_under_replicated", "legendFormat": "under-replicated", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 100 }] }
        }
      }
    },
    {
      "title": "节点写错误率",
      "description": "每个 datanode 的滚动写错误率 (0.0–1.0)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 51 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        { "expr": "nufs_node_write_error_rate", "legendFormat": "node {{ node_id }}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.2 }, { "color": "red", "value": 0.5 }] }
        }
      }
    },
    {
      "title": "节点磁盘 I/O",
      "description": "每个 datanode 的磁盘 I/O 利用率 (0.0–1.0)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 51 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        { "expr": "nufs_node_disk_io", "legendFormat": "node {{ node_id }}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "节点存储用量",
      "description": "每个节点的已用 / 总容量",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 59 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        { "expr": "nufs_node_used_bytes / nufs_node_capacity_bytes", "legendFormat": "node {{ node_id }}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.85 }, { "color": "red", "value": 0.95 }] }
        }
      }
    },
    {
      "title": "Bucket 配额用量",
      "description": "每个 bucket 的字节/对象配额使用率",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 59 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        { "expr": "nufs_bucket_quota_used_ratio", "legendFormat": "{{ bucket }} ({{ resource }})", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.80 }, { "color": "red", "value": 0.95 }] }
        }
      }
    },
    {
      "title": "Object Write 状态分布",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 67 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        { "expr": "nufs_object_write_attempts", "legendFormat": "{{ state }}", "refId": "A" }
      ]
    },
    {
      "title": "修复队列",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 67 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        { "expr": "metad_repair_tasks_queued", "legendFormat": "queued", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 1000 }] }
        }
      }
    },
    {
      "title": "备份状态",
      "description": "最近一次成功备份的时间戳",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 67 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        { "expr": "nufs_backup_last_success_timestamp_seconds", "legendFormat": "last backup", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsSystem",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "title": "Chunk Tombstone 积压",
      "description": "最老 tombstone 的年龄（秒）",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 71 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        { "expr": "nufs_chunk_tombstone_oldest_age_seconds", "legendFormat": "oldest age", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 36000 }, { "color": "red", "value": 93600 }] }
        }
      }
    },
    {
      "title": "重平衡字节迁移",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 71 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        { "expr": "metad_rebalance_bytes_moved", "legendFormat": "bytes moved", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["nufs", "storage"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus",
        "multi": false,
        "name": "prometheus",
        "options": [],
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "NUFS 生产监控",
  "uid": "nufs-production",
  "version": 1
}
