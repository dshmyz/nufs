# ============================================================
# NUFS 多虚拟机集群配置 —— 唯一需要手填的集群级配置
#
# 用法：
#   1. cp cluster.env.example cluster.env
#   2. 填下面的 IP / 端口（默认端口无需改）
#   3. 运行 ./deploy.sh gen-keys 生成三把密钥，粘贴到下方
#   4. 把 deploy.sh + cluster.env 拷到每一台 VM，然后 ./deploy.sh install
#      脚本会按本机 IP 自动识别该 VM 跑什么角色（metad/datanode/s3）
# ============================================================

# ---- 拓扑 ----
# 3 台 metad VM 的 IP。数组顺序 = 节点编号（1/2/3）。
# 三台同 IP 也可以（单机测试），跨机就填各自真实 IP。
METAD_IPS=(127.0.0.1 127.0.0.1 127.0.0.1)

# 3 台 datanode VM 的 IP。数组顺序 = 节点编号（1/2/3）。
DATANODE_IPS=(127.0.0.1 127.0.0.1 127.0.0.1)

# S3 网关 VM 的 IP。
S3_IP=127.0.0.1

# [可选] 网关/datanode 访问 metad 的稳定地址。留空 = 指向 metad-1。
# 3 台 metad 后挂一个 VIP/代理（keepalived、haproxy 等）时填 <VIP>:<METAD_OPS_PORT>，
# 这样任意一台 metad 故障，网关都能被路由到新 leader，无需重启。
METAD_SERVICE_ADDR=

# ---- 端口（按节点编号自动 +0/+1/+2，无需改）----
METAD_OPS_PORT=18091       # metad 1 ops HTTP；2/3 依次 18092/18093
METAD_RAFT_PORT=17001      # metad 1 raft 传输；2/3 依次 17002/17003
DATANODE_CHUNK_PORT=9103   # datanode 1 数据端口；2/3 依次 9104/9105
DATANODE_OPS_PORT=18096    # datanode 1 ops HTTP；2/3 依次 18097/18098
S3_PORT=8081               # S3 网关 HTTP

# ---- 数据目录（每台 VM 本地）----
DATA_ROOT=/var/lib/nufs

# ---- 密钥：运行 ./deploy.sh gen-keys 生成后粘贴到这里 ----
# AUTH_TOKEN        ops API 的 Bearer token（metad/datanode/s3 共用同一把）
# TOKEN_SIGNING_KEY 挂载认证 HMAC 签名 key（须与 nufs-fuse 共享）
# CRED_SECRET_KEY   S3 凭据注册表加密 key（必须 32 字节 hex = 64 个 hex 字符）
AUTH_TOKEN=
TOKEN_SIGNING_KEY=
CRED_SECRET_KEY=
