[Unit]
Description=NUFS Data Node (port %i)
Documentation=https://github.com/dshmyz/nufs/nufs-core
After=network.target nufs-metad.service

[Service]
Type=simple
User=nufs
Group=nufs
EnvironmentFile=-/etc/default/nufs-datanode
ExecStart=/usr/local/bin/datanode \
    --node-id=auto \
    --listen=0.0.0.0:%i \
    --data-dir=/var/lib/nufs/datanode-%i \
    --metadata=localhost:8091 \
    --rack=${RACK:-rack1} \
    --zone=${ZONE:-zone1} \
    --capacity=${CAPACITY_GB:-500} \
    --log-level=${LOG_LEVEL:-info} \
    --log-format=${LOG_FORMAT:-text}

Restart=always
RestartSec=5
LimitNOFILE=65536

NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
PrivateTmp=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
