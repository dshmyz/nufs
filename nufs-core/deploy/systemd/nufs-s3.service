[Unit]
Description=NUFS S3 Gateway
Documentation=https://github.com/example/dfs
After=network.target nufs-metad.service
Requires=nufs-metad.service

[Service]
Type=simple
User=nufs
Group=nufs
EnvironmentFile=-/etc/default/nufs-s3
ExecStart=/usr/local/bin/nufs-s3 \
    --listen=0.0.0.0:8080 \
    --meta-addr=localhost:8091 \
    --part-dir=/var/lib/nufs-s3/parts \
    --rate-limit=${RATE_LIMIT:-1000} \
    --rate-limit-burst=${RATE_LIMIT_BURST:-2000} \
    --credentials-file=${CREDENTIALS_FILE:-/etc/nufs/credentials.yaml} \
    --log-level=${LOG_LEVEL:-info} \
    --log-json=${LOG_JSON:-false}

Restart=always
RestartSec=5
LimitNOFILE=65536

NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
PrivateTmp=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
